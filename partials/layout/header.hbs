<header class="header js-header h-16 w-full text-sm flex items-center sticky top-0 z-20">
    <div class="header-wrap mx-auto flex items-center flex-auto px-4 w-full max-w-extreme">
        {{!-- Logo --}}
        <div class="header-left mr-5 flex flex-none items-center">
            <a href="{{#match @site.locale "de"}}/{{else}}/en/{{/match}}"
                class="header-logo inline-block leading-none godo-tracking"
                data-event-category="Header"
                data-event-action="Logo"
                data-event-label="Click"
                data-event-non-interaction="true">
                {{#if @site.logo}}
                    <img src="{{img_url @site.logo size="m"}}" class="header-logo-img max-h-9 logo-default" alt="{{@site.title}}" width="115" height="30"/>
                    {{!-- <img src="{{asset "images/logo-dark-mode.png"}}" class="header-logo-img max-h-9 hidden logo-dark-mode" alt="" width="115" height="30"/> --}}
                {{else}}
                    <span class="text-3xl font-bold text-logo">{{@site.title}}</span>
                {{/if}}
            </a>
        </div>

        {{!-- Navigation --}}
        {{> "multilingual-navigation"}}

        <div class="header-right flex-none flex justify-end items-center">
            {{!-- Language Switcher --}}
            <div class="language-switcher relative mr-2">
                <a role="button" class="js-language-toggle button is-white dark:text-white dark:hover:bg-gray-700" aria-label="Language Switcher">
                    <span class="current-language">{{#match @site.locale "de"}}DE{{else}}EN{{/match}}</span>
                </a>
                <div class="language-dropdown absolute right-0 top-full mt-1 bg-white dark:bg-gray-800 shadow-md rounded-md hidden">
                    {{#if post}}
                        {{!-- Handle author pages specifically --}}
                        {{#is "author"}}
                            {{#match @site.locale "de"}}
                                {{!-- Currently on German author page, link to English --}}
                                <a href="/team/{{slug}}/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">EN</a>
                                <a href="/profil/{{slug}}/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">DE</a>
                            {{else}}
                                {{!-- Currently on English author page, link to German --}}
                                <a href="/team/{{slug}}/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">EN</a>
                                <a href="/profil/{{slug}}/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">DE</a>
                            {{/match}}
                        {{else}}
                            {{!-- Handle regular posts/pages --}}
                            {{#has tag="en"}}
                                {{#get "posts" filter="primary_author:{{primary_author.slug}}+tag:de+slug:{{slug}}" limit="1" as |translated|}}
                                    {{#if translated}}
                                        {{#foreach translated}}
                                            <a href="{{url}}" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "de"}}font-bold{{/match}}">DE</a>
                                        {{/foreach}}
                                    {{else}}
                                        <a href="/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "de"}}font-bold{{/match}}">DE</a>
                                    {{/if}}
                                {{/get}}
                                <a href="/en/{{slug}}/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">EN</a>
                            {{else}}
                                {{#has tag="de"}}
                                    <a href="/{{slug}}/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">DE</a>
                                    {{#get "posts" filter="primary_author:{{primary_author.slug}}+tag:en+slug:{{slug}}" limit="1" as |translated|}}
                                        {{#if translated}}
                                            {{#foreach translated}}
                                                <a href="{{url}}" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "en"}}font-bold{{/match}}">EN</a>
                                            {{/foreach}}
                                        {{else}}
                                            <a href="/en/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "en"}}font-bold{{/match}}">EN</a>
                                        {{/if}}
                                    {{/get}}
                                {{else}}
                                    <a href="/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "de"}}font-bold{{/match}}">DE</a>
                                    <a href="/en/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "en"}}font-bold{{/match}}">EN</a>
                                {{/has}}
                            {{/has}}
                        {{/is}}
                    {{else}}
                        {{!-- Handle collection pages --}}
                        {{#is "home"}}
                            <a href="/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "de"}}font-bold{{/match}}">DE</a>
                            <a href="/en/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "en"}}font-bold{{/match}}">EN</a>
                        {{else}}
                            {{!-- Map collection pages between languages --}}
                            {{#is "author"}}
                                {{#match @site.locale "de"}}
                                    <a href="/profil/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">DE</a>
                                    <a href="/team/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">EN</a>
                                {{else}}
                                    <a href="/profil/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">DE</a>
                                    <a href="/team/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">EN</a>
                                {{/match}}
                            {{else}}
                                {{#is "tag"}}
                                    {{!-- Handle tag pages --}}
                                    {{#match @site.locale "de"}}
                                        <a href="/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">DE</a>
                                        <a href="/en/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">EN</a>
                                    {{else}}
                                        <a href="/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">DE</a>
                                        <a href="/en/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white font-bold">EN</a>
                                    {{/match}}
                                {{else}}
                                    {{!-- Default for other collection pages --}}
                                    <a href="/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "de"}}font-bold{{/match}}">DE</a>
                                    <a href="/en/" class="language-option block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white {{#match @site.locale "en"}}font-bold{{/match}}">EN</a>
                                {{/is}}
                            {{/is}}
                        {{/is}}
                    {{/if}}
                </div>
            </div>

            {{!-- Light and Dark Mode --}}
            <a role="button" class="js-dark-mode button is-white items-center mr-2" aria-label="Dark and Light Mode">
                <svg class="icon icon--moon m-0" style="margin-right:calc(-0.5em - 1px)"><use xlink:href="#icon-moon"></use></svg>
                <svg class="icon icon--sunny m-0 hidden" style="margin-left:calc(-0.5em - 1px)"><use xlink:href="#icon-sunny"></use></svg>
            </a>

            {{!-- Toggle Searcg --}}
            <a href="#/search"
                role="button"
                aria-label="Toggle Search"
                class="godo-tracking button is-white mr-2"
                aria-haspopup="true"
                data-event-category="Header"
                data-event-action="Search"
                data-event-label="Click"
                data-event-non-interaction="true"
                data-ghost-search>
                <svg class="icon icon--search"><use xlink:href="#icon-search"></use></svg>
            </a>

            {{!-- Menu User Account --}}
            {{#if @site.members_enabled}}{{> "layout/account-menu"}}{{/if}}

            {{!-- Toggle Menu --}}
            <a href="javascript:;" role="button" aria-label="Show Navigation Menu" class="js-menu-toggle menu-burger button is-white relative lg:hidden"><span></span><span></span><span></span></a>
        </div>
    </div>
</header>

{{!-- Menu Mobile --}}
{{>"sidenav"}}